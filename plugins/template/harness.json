{
  "schema_version": 1,
  "plugin": "tj-agents/template",
  "source_roots": [
    ".agents/template/skills/check",
    ".agents/template/skills/new/plugin",
    ".agents/template/skills/update"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "tj-agents",
        "repository": "tj-agents/marketplace"
      }
    ],
    "plugins": [
      "tj-agents/template",
      "tj-agents/base",
      "tj-agents/engineering",
      "tj-agents/skill"
    ],
    "permissions": {
      "claude_allow": [
        "Bash(python -B ${PLUGIN_ROOT}/skills/check/scripts/check_examples.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/check/scripts/check_examples.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/skills/check/scripts/check_examples.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/skills/check/scripts/check_examples.py:*)",
        "Bash(python -B ${PLUGIN_ROOT}/skills/check/scripts/check_skill_references.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/check/scripts/check_skill_references.py:*)",
        "Bash(python3 -B ${PLUGIN_ROOT}/skills/check/scripts/check_skill_references.py:*)",
        "PowerShell(python3 -B ${PLUGIN_ROOT}/skills/check/scripts/check_skill_references.py:*)"
      ],
      "codex_prefix_rules": [
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            "${PLUGIN_ROOT}/skills/check/scripts/check_examples.py"
          ],
          "justification": "Reads a declared repository's changed authored skills and reports a missing concrete fenced example; it does not change repository or session state",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/skills/check/scripts/check_examples.py",
              "--root",
              "${PROJECT_ROOT}",
              "--base",
              "origin/main"
            ]
          ],
          "not_match": [
            [
              "python",
              "${PLUGIN_ROOT}/skills/check/scripts/check_examples.py"
            ]
          ]
        },
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            "${PLUGIN_ROOT}/skills/check/scripts/check_skill_references.py"
          ],
          "justification": "Reads declared repository documents against supplied shipped skill inventories and reports unresolved identities",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/skills/check/scripts/check_skill_references.py",
              "--root",
              "${PROJECT_ROOT}",
              "--reference-path",
              "${PROJECT_ROOT}/docs/standards.md"
            ]
          ],
          "not_match": [
            [
              "python",
              "${PLUGIN_ROOT}/skills/check/scripts/check_skill_references.py"
            ]
          ]
        }
      ]
    }
  }
}
