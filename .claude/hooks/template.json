{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/SKILL.md)",
            "timeout": 10,
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse/claude/new_skill.py"
            ]
          }
        ]
      }
    ]
  }
}
