      "reasoning_effort": "medium",
      "context_ceiling": null,
      "why": "the small family at medium effort. Clerical loops and bulk passes -- a monitor, a long transcript, a big diff -- that outgrow the floor rung."
    },
    "L7": {
      "summary": "Clerical work with a small input and no judgement to make.",
