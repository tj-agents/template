#!/usr/bin/env pwsh
[CmdletBinding()]
param([switch]$Check)
$ErrorActionPreference = 'Stop'
$arguments = @('-B', (Join-Path $PSScriptRoot 'sync_generated.py'), '--root', (Split-Path -Parent $PSScriptRoot))
if ($Check) { $arguments += '--check' }
try {
    & python @arguments
    $exitCode = $LASTEXITCODE
    if ($null -eq $exitCode) { throw 'Python returned no process exit code.' }
}
catch {
    Write-Error $_
    exit 1
}
exit $exitCode
name: plugin-ci

on:
  workflow_call:
    inputs:
      kit_ref:
        description: The kit release the calling repository pins, such as v1.0.0.
        required: true
        type: string
      generate_before_verify:
        required: false
        default: false
        type: boolean
    secrets:
      read_token:
        description: A token that can read the organization's kit and core repositories.
        required: false

jobs:
  verify:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/checkout@v4
        with:
          repository: ${{ github.repository_owner }}/kit
          ref: ${{ inputs.kit_ref }}
          path: .kit
          token: ${{ secrets.read_token || secrets.GITHUB_TOKEN }}
      - uses: actions/checkout@v4
        with:
          repository: ${{ github.repository_owner }}/core
          path: .core
          token: ${{ secrets.read_token || secrets.GITHUB_TOKEN }}
      - uses: actions/checkout@v4
        with:
          repository: tj-agents/react
          path: .react
          token: ${{ secrets.read_token || secrets.GITHUB_TOKEN }}
      - uses: actions/checkout@v4
        with:
          repository: tj-agents/dotnet
          path: .dotnet
          token: ${{ secrets.read_token || secrets.GITHUB_TOKEN }}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: regenerate generated files from authored sources
        if: inputs.generate_before_verify
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $PSNativeCommandUseErrorActionPreference = $true
          ./.agents/sync-generated.ps1
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
      - name: generated files are current
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $PSNativeCommandUseErrorActionPreference = $true
          ./.agents/sync-generated.ps1 -Check
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
      - name: repository tests
        shell: pwsh
        run: |
          if (Test-Path .agents/tests/test_*.py) {
            python -B -m unittest discover -s .agents/tests -p "test_*.py"
            exit $LASTEXITCODE
          }
      - name: the repository conforms to its pinned kit release
        shell: pwsh
        run: python -B .kit/.agents/kit/utility/check/scripts/check.py --root .
      - name: authored skill references resolve in the public corpus
        shell: pwsh
        run: python -B .kit/.agents/kit/utility/check/scripts/check_skill_references.py --root . --root .kit --root .core --root .react --root .dotnet --source-root .
      - name: tier payloads conform to the shipped shape
        shell: pwsh
        run: python -B .core/plugins/base/hooks/check_tier_payload.py --root .

  hosts:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/checkout@v4
        with:
          repository: ${{ github.repository_owner }}/kit
          ref: ${{ inputs.kit_ref }}
          path: .kit
          token: ${{ secrets.read_token || secrets.GITHUB_TOKEN }}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: regenerate generated files from authored sources
        if: inputs.generate_before_verify
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $PSNativeCommandUseErrorActionPreference = $true
          ./.agents/sync-generated.ps1
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
      - name: generated files are current
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $PSNativeCommandUseErrorActionPreference = $true
          ./.agents/sync-generated.ps1 -Check
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: install the pinned host CLIs
        run: npm install --global @anthropic-ai/claude-code@2.1.282 @openai/codex@0.159.2
      - name: Claude Code and Codex accept the marketplace and plugins
        run: python -B .kit/.github/scripts/validate_hosts.py --root .


